# Copy to deploy/gateway.env (gitignored) and `chmod 600 deploy/gateway.env`.
# Read by deploy/docker-compose.yml via env_file. Single quotes keep the value literal.
# The password only applies until it is changed in the Web Console; after that the salted
# hash in gateway.db is authoritative. Minimum length: 8 characters.
# AG_ADMIN_PASSWORD='change-me-to-a-long-random-password'
# AG_ADMIN_TOKEN='at-least-12-characters'
